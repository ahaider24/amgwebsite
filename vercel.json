{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.amirgetsjobs.com"
        }
      ],
      "destination": "https://amirgetsjobs.com/:path*",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/field-notes",
      "permanent": true
    },
    {
      "source": "/ASTRA_SITE_STRATEGY_REPORT.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ASTRA_RESULTS_REPORT.md",
      "destination": "/",
      "permanent": false
    }
  ]
}
